rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function loggedIn() { return request.auth != null; }
    function staffExists() {
      return loggedIn() && exists(/databases/$(database)/documents/staff/$(request.auth.uid));
    }
    function staffData() {
      return get(/databases/$(database)/documents/staff/$(request.auth.uid)).data;
    }
    function leader() {
      return staffExists() && (staffData().role == "leader" || staffData().role == "admin");
    }
    function facilitator() {
      return staffExists() && staffData().role == "facilitator";
    }

    // Únicamente las Cloud Functions (Admin SDK) pueden modificar datos.
    // El SDK administrativo no está sujeto a estas reglas: las funciones
    // verifican autenticación, rol, token, estación, orden y estado.
    match /staff/{uid} {
      allow get: if loggedIn() && (request.auth.uid == uid || leader());
      allow list: if leader();
      allow create, update, delete: if false;
    }
    match /events/{eventId} {
      allow get: if loggedIn() && eventId == "current";
      allow list: if false;
      allow create, update, delete: if false;

      match /teams/{teamId} {
        allow get: if loggedIn() &&
          (leader() || facilitator() || resource.data.ownerUid == request.auth.uid);
        allow list: if leader();
        allow create, update, delete: if false;
      }
      // Los enlaces de inscripción privados solo se muestran al líder.
      match /teamInvites/{teamId} {
        allow get, list: if leader();
        allow create, update, delete: if false;
      }
      match /facInvites/{stationId} {
        allow get, list: if leader();
        allow create, update, delete: if false;
      }
      // Ni equipos ni facilitadores reciben secretos anticipadamente.
      match /rewards/{teamId} {
        allow read, write: if false;
      }
      match /proofs/{proofId} {
        allow read, write: if false;
      }
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
